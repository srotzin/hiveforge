PORT=3003
NODE_ENV=development

# PostgreSQL (omit for in-memory mode)
DATABASE_URL=postgresql://user:password@localhost:5432/hiveforge

# HiveTrust integration (Identity)
HIVETRUST_API_URL=https://hivetrust.onrender.com
HIVE_INTERNAL_KEY=

# HiveAgent integration (Commerce)
HIVEAGENT_API_URL=https://hiveagentiq.com

# HiveMind integration (Memory)
HIVEMIND_API_URL=http://localhost:3002

# Payment
STRIPE_SECRET_KEY=
HIVE_PAYMENT_ADDRESS=

# Forge config
MUTATION_RATE_DEFAULT=0.1
EVOLUTION_INTERVAL_MS=300000

# Error tracking
SENTRY_DSN=
